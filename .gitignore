# ==============================================================================
# Alex Morgan Personal Portfolio — .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build & Bundler Caches
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# Environment Variables & Secrets
.env
.env.*
*.env
*.local
!.env.example

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Linter & Test Caches
.eslintcache
.stylelintcache
coverage/

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sw?
*.bak
*.tmp
